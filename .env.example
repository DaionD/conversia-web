# === Exchange / Broker Selection ===
# Any CCXT exchange id works out of the box: binance, bybit, kucoin, okx,
# kraken, bitget, gateio, mexc, etc. Native broker adapters (not yet
# implemented, structure ready): mt5, interactive_brokers
EXCHANGE_NAME=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
# Only required by some exchanges (OKX, KuCoin, Bitget use a passphrase)
API_PASSWORD=
SANDBOX_MODE=true

# === Market Scope ===
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h
POLL_SECONDS=60

# === Regime-Switching Engine ===
ADX_PERIOD=14
ADX_TREND_THRESHOLD=25.0
ATR_PERIOD=14
BANDWIDTH_PERIOD=20
BANDWIDTH_COMPRESSION_PERCENTILE=0.20

# === Strategy Parameters ===
MA_FAST_PERIOD=50
MA_SLOW_PERIOD=200
ADX_MIN_STRENGTH=20.0
RSI_PERIOD=14
RSI_OVERBOUGHT=70.0
RSI_OVERSOLD=30.0
BREAKOUT_LOOKBACK_PERIOD=20

# === Risk Engine ===
RISK_PER_TRADE_PCT=0.75
MIN_RISK_REWARD=1.5
ATR_SL_MULTIPLIER=1.5
ATR_TRAILING_MULTIPLIER=2.0
BREAKEVEN_TRIGGER_RR=1.0
MAX_DAILY_DRAWDOWN_PCT=3.0
KILL_SWITCH_COOLDOWN_HOURS=24

# === Logging ===
LOG_LEVEL=INFO

# === API Layer ===
API_HOST=0.0.0.0
API_PORT=8000
# Set to true only once EXCHANGE_NAME/API_KEY/API_SECRET above are ready to
# trade (sandbox or live): this makes the API start the real trading loop
# in the background. false serves the API/dashboard with an empty state.
API_RUN_ENGINE=false
# Comma-separated list of allowed origins for the dashboard, or * for any.
CORS_ORIGINS=*
WS_BROADCAST_INTERVAL_SECONDS=2.0
